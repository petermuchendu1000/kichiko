# Elopis Environment Variables
# Copy this to .env.local and fill in your values

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client (browser-safe) key. New format: sb_publishable_... (or legacy anon JWT).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# SERVER-ONLY secret. MUST be the service-role key: new format sb_secret_...
# (or the legacy service_role JWT). If this holds an anon/publishable key or is
# empty, the admin client silently runs as `anon` and every privileged RPC fails
# with 42501 "permission denied for function ..." (e.g. clob_place_order on the
# trade panel). createAdminClient() now throws on a missing/anon key to catch this.
# NEVER prefix this with NEXT_PUBLIC_ -- it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Elopis
NEXT_PUBLIC_APP_DESCRIPTION=East Africa's Premier Prediction Market Platform
NODE_ENV=development

# ============================================================
# AUTHENTICATION
# ============================================================
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# ============================================================
# M-PESA (Safaricom - Kenya)
# Docs: https://developer.safaricom.co.ke/
# ============================================================
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-mpesa-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa
MPESA_ENV=sandbox
# sandbox: https://sandbox.safaricom.co.ke
# production: https://api.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Webhook source verification (STRONGLY recommended for production).
# Shared secret appended to the callback/ResultURL as ?token=... and matched in
# constant time. REQUIRED to secure the B2C payout result endpoint (money-out),
# which has no authoritative re-query. Generate a long random value.
MPESA_WEBHOOK_SECRET=
# Optional comma-separated allowlist of Safaricom callback source IPs.
MPESA_WEBHOOK_IP_ALLOWLIST=

# ============================================================
# MTN MOMO (Uganda, Rwanda, Ghana - MoMo API)
# Docs: https://momodeveloper.mtn.com/
# ============================================================
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your-subscription-key
MTN_MOMO_API_USER=your-api-user-uuid
MTN_MOMO_API_KEY=your-api-key
MTN_MOMO_CALLBACK_URL=https://your-domain.com/api/webhooks/mtn-momo
MTN_MOMO_ENV=sandbox
# sandbox | production. In production the X-Target-Environment is the
# country's MTN environment (UG -> mtnuganda); set MTN_MOMO_TARGET_ENV to
# override. One disbursement key serves payouts AND payout status queries:
MTN_MOMO_DISBURSEMENT_KEY=your-disbursement-subscription-key
# MTN_MOMO_TARGET_ENV=mtnuganda

# ============================================================
# AIRTEL MONEY (Tanzania, Uganda, Kenya, Rwanda, Zambia)
# Docs: https://developers.airtel.africa/
# ============================================================
AIRTEL_MONEY_CLIENT_ID=your-airtel-client-id
AIRTEL_MONEY_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_MONEY_CALLBACK_URL=https://your-domain.com/api/webhooks/airtel
AIRTEL_MONEY_ENV=sandbox
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
# payout PIN (AIRTEL_MONEY_PIN is also read; a DB gateway secret wins)
AIRTEL_DISBURSEMENT_PIN=your-disbursement-pin

# ============================================================
# PESAPAL (Multi-currency East Africa)
# Supports: KES, UGX, TZS, RWF, ZMW
# Docs: https://developer.pesapal.com/
# ============================================================
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_URL=https://your-domain.com/api/webhooks/pesapal
PESAPAL_ENV=sandbox
# sandbox: https://cybqa.pesapal.com/pesapalv3
# production: https://pay.pesapal.com/v3
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3

# ============================================================
# CURRENCY & FINANCIAL CONFIG
# ============================================================
# Supported currencies: KES, UGX, TZS, RWF, ZMW, ETB, BIF
SUPPORTED_CURRENCIES=KES,UGX,TZS,RWF,ZMW
DEFAULT_CURRENCY=KES
# Fee percentage (e.g. 0.02 = 2%)
PLATFORM_FEE_RATE=0.02
# Minimum bet amounts per currency
MIN_BET_KES=50
MIN_BET_UGX=2000
MIN_BET_TZS=5000
MIN_BET_RWF=1000

# ============================================================
# OPEN EXCHANGE RATES (for currency conversion)
# Docs: https://openexchangerates.org/
# ============================================================
OPEN_EXCHANGE_RATES_APP_ID=your-open-exchange-rates-app-id

# ============================================================
# EMAIL (Resend - easy transactional email)
# Docs: https://resend.com/
# ============================================================
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Elopis <noreply@elopis.com>
EMAIL_FROM=noreply@elopis.com
EMAIL_REPLY_TO=support@elopis.com

# ============================================================
# SMS (Africa's Talking - covers EA countries)
# Docs: https://africastalking.com/
# ============================================================
# The username selects the environment: the literal "sandbox" talks to
# api.sandbox.africastalking.com, anything else is live. There is no separate
# flag to get out of step with.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
# An ALPHANUMERIC sender ID must be registered with Africa's Talking before it
# will send. An unregistered one comes back 402 InvalidSenderId on every single
# message. Leave EMPTY until it is approved: unset falls back to the shared
# short code, which works immediately.
AFRICASTALKING_SENDER_ID=
# Shared secret for the delivery-report callback, which you register in the AT
# dashboard as:
#   https://elopis.com/api/webhooks/africastalking/dlr?token=<this value>
# AT does not sign delivery reports and cannot send a custom header, so the
# secret in the URL is the only control available. The route FAILS CLOSED
# without it: an unauthenticated caller there can mark a payout SMS failed.
AFRICASTALKING_WEBHOOK_SECRET=

# ============================================================
# REDIS / UPSTASH (rate limiting, caching)
# Docs: https://upstash.com/
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ============================================================
# ADMIN
# ============================================================
ADMIN_SECRET_KEY=your-very-secret-admin-key-change-this

# ============================================================
# CRON / MARKET RESOLUTION
# ============================================================
CRON_SECRET=your-cron-secret-key
# Recurring "Bitcoin Up or Down" engine (/api/cron/btc-windows) reuses CRON_SECRET
# and needs no API key — it samples free public spot feeds (Coinbase/Kraken/CoinGecko).
# Register it once per env from the SQL editor:
#   SELECT public.schedule_elopis_btc_jobs('https://<your-app-host>', '<CRON_SECRET>');

# ============================================================
# SENTRY (error monitoring - optional)
# ============================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ============================================================
# VERCEL (auto-set by Vercel, leave blank locally)
# ============================================================
VERCEL_URL=

# ============================================================
# DIDIT - identity verification (KYC)
# Console: https://business.didit.me  ·  Docs: https://docs.didit.me
# ============================================================
# Server-side only. Anyone holding this key can create verification sessions
# on your account, so it must never reach NEXT_PUBLIC_* or the browser.
DIDIT_API_KEY=
# Which workflow a session runs. Read the ids from GET /v3/workflows/.
#   "Free KYC"  OCR + liveness + face match + IP analysis        $0.00-0.33
#   "KYC + AML" the same, plus sanctions and PEP screening       $0.42-0.65
# AML screening is what POCAMLA 2009 expects of a platform moving money, and
# it is not something a human reviewer here can perform, so the extra ~$0.32
# per verified user buys a control that otherwise does not exist.
DIDIT_WORKFLOW_ID=
# From the Didit console, API & Webhooks -> the destination's shared secret.
# /api/webhooks/didit FAILS CLOSED without it: an unsigned caller to that route
# could mark any account verified, so an unset secret answers 503 rather than
# trusting the body.
DIDIT_WEBHOOK_SECRET=
